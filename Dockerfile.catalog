# Rancher UI extension catalog — static Helm/plugin repo over HTTP.
# Built from a staging dir by scripts/catalog-build.sh (not from repo root:
# .dockerignore excludes charts/extensions/assets).
#
#   make catalog-build
#
FROM busybox:1.36

COPY index.yaml /srv/index.yaml
COPY assets /srv/assets
COPY charts /srv/charts
COPY extensions /srv/extensions

EXPOSE 8080
USER nobody
CMD ["httpd", "-f", "-v", "-p", "8080", "-h", "/srv"]
